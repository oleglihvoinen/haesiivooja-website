---
import '../styles/global.css';
import {site,navigation} from '../data/site';
import {ui,alternateFor} from '../data/i18n';
const {title,description,canonicalPath='/',breadcrumbs=[],schema=[],lang='fi'} = Astro.props;
const english=lang==='en';
const t=ui[english?'en':'fi'];
const url=new URL(canonicalPath,site.url).href;
const fullTitle=title ? `${title} | ${site.name}` : (english ? 'Hae Siivooja – Find Cleaners and Cleaning Clients in Finland' : 'Hae Siivooja – löydä siivooja tai siivousasiakkaita Suomessa');
const desc=description||(english?'HaeSiivooja Android cleaning marketplace in Finland: customers find cleaners and professionals find new customers. Open testing on Google Play.':site.description);
const fiPath=alternateFor(canonicalPath,'fi');
const enPath=alternateFor(canonicalPath,'en');
const altFi=fiPath?new URL(fiPath,site.url).href:null;
const altEn=enPath?new URL(enPath,site.url).href:null;
const organization={
 '@type':'Organization','@id':`${site.url}/#organization`,name:'Hae Siivooja',url:site.url,
 logo:`${site.url}/brand/mascot.png`,contactPoint:{'@type':'ContactPoint',email:site.email,contactType:'customer support'},sameAs:[site.playUrl]
};
const webSite={'@type':'WebSite','@id':`${site.url}/#website`,name:site.name,url:site.url,inLanguage:['fi-FI','en'],publisher:{'@id':`${site.url}/#organization`}};
const pageSchema={'@type':'WebPage','@id':`${url}#webpage`,name:fullTitle,description:desc,url,inLanguage:english?'en':'fi-FI',isPartOf:{'@id':`${site.url}/#website`},...(altFi&&altEn?{translationOfWork:{'@id':`${altFi}#webpage`}}:{})};
const crumbs=breadcrumbs.length?{'@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:t.home,item:new URL(english?'/en/':'/',site.url).href},...breadcrumbs.map((b,i)=>({'@type':'ListItem',position:i+2,name:b.title,item:new URL(b.href,site.url).href}))]}:null;
const jsonLd={'@context':'https://schema.org','@graph':[organization,webSite,pageSchema,...schema,...(crumbs?[crumbs]:[])]};
const links=english?{
 find:'/en/find-a-cleaner/',services:'/en/cleaning-services/',price:'/en/cleaning-prices/',guides:'/en/guides/',cleaners:'/en/for-cleaners/',about:'/en/about-us/',contact:'/en/contact/'
}:{find:'/etsi-siivooja/',services:'/siivouspalvelut/',price:'/siivouksen-hinta/',guides:'/oppaat/',cleaners:'/siivoojaksi/',about:'/tietoa-meista/',contact:'/yhteystiedot/'};
---
<!doctype html>
<html lang={english?'en':'fi'}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0b3945" />
    <title>{fullTitle}</title>
    <link rel="canonical" href={url} />
    {altFi&&altEn&&<>
      <link rel="alternate" hreflang="fi" href={altFi} />
      <link rel="alternate" hreflang="en" href={altEn} />
      <link rel="alternate" hreflang="x-default" href={altFi} />
    </>}
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=20261101b" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=20261101b" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={english?'en_US':'fi_FI'} />
    {altFi&&altEn&&<meta property="og:locale:alternate" content={english?'fi_FI':'en_US'}/>}
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta name="twitter:card" content="summary" />
    <meta name="application-name" content="HaeSiivooja" />
    <meta property="og:see_also" content={site.playUrl} />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip" href="#content">{t.skip}</a>
    <header><div class="container inner">
      <a class="logo" href={english?'/en/':'/'} aria-label="HaeSiivooja"><img class="brand-mascot" src="/brand/mascot.png?v=20261101b" width="76" height="76" alt="" decoding="async" /> HaeSiivooja</a>
      <nav class="nav" aria-label={t.navLabel}>
        {navigation[english?'en':'fi'].map(item=><a href={item.href}>{item.title}</a>)}
        <a class="button nav-download" href={site.playUrl} target="_blank" rel="noopener noreferrer">{english?'▶ Google Play · Open test':'▶ Google Play · Avoin testaus'}</a>
        <span class="lang-switch" aria-label="Language / Kieli">
          {english&&fiPath?<a href={fiPath} lang="fi" hreflang="fi">FI</a>:<span aria-current="page">FI</span>}
          <span aria-hidden="true"> / </span>
          {!english&&enPath?<a href={enPath} lang="en" hreflang="en">EN</a>:<span aria-current="page">EN</span>}
        </span>
      </nav>
    </div></header>
    <main id="content"><slot /></main>
    <footer class="footer"><div class="container">
    <div class="footer-cols">
      <div><h3 class="footer-brand"><img class="brand-footer-mascot" src="/brand/mascot.png" width="70" height="70" alt="" loading="lazy" decoding="async" />Hae Siivooja</h3><p>{english?'A Finnish digital marketplace: customers find cleaners and cleaners find customers.':'Suomalainen digitaalinen markkinapaikka: asiakkaat löytävät siivoojan ja siivoojat löytävät asiakkaita.'}</p><p><a href={`mailto:${site.email}`}>{site.email}</a></p></div>
      <div><strong>{english?'Company':'Yritys'}</strong><ul>
        <li><a href={links.about}>{english?'Our history':'Meidän tarinamme'}</a></li>
        <li><a href={links.contact}>{english?'Contact us':'Ota meihin yhteyttä'}</a></li>
      </ul><strong>{english?'For customers':'Asiakkaille'}</strong><ul>
        <li><a href={links.find}>{english?'Find a cleaner':'Etsi siivooja'}</a></li><li><a href={site.searchUrl}>{english?'AI cleaning search (optional)':'AI-siivoushaku (lisätoiminto)'}</a></li>
        <li><a href={links.price}>{english?'HaeSiivooja prices':'HaeSiivoojan hinnasto'}</a></li>
      </ul></div>
      <div><strong>{english?'Hae Siivooja app':'Hae Siivooja -sovellus'}</strong><ul>
        <li><a href={english?'/en/terms-of-service/':'/terms-of-service/'}>{english?'Terms of service':'Käyttöehdot'}</a></li>
        <li><a href={english?'/en/privacy/':'/privacy/'}>{english?'Privacy policy':'Tietosuojakäytäntö'}</a></li>
        <li><a href={english?'/en/accessibility-statement/':'/accessibility-statement/'}>{english?'Accessibility':'Saavutettavuusseloste'}</a></li>
        <li><a href={english?'/en/app-guide/':'/app-guide/'}>{english?'App guide':'Sovelluksen opas'}</a></li>
        <li><a href={english?'/en/payments/':'/maksut/'}>{english?'Payments':'Maksut'}</a></li>
        <li><a href={english?'/en/cleaner-terms/':'/cleaner/'}>{english?'Cleaner terms':'Siivoojan ehdot'}</a></li>
        <li><a href={english?'/en/delete-account/':'/tilin-poisto/'}>{english?'Delete account':'Tilin poistaminen'}</a></li>
      </ul></div>
      <div><strong>{english?'For cleaners':'Siivoojille'}</strong><ul>
        <li><a href={links.cleaners}>{english?'Find customers':'Löydä asiakkaita'}</a></li>
        <li><a href={site.playUrl} target="_blank" rel="noopener noreferrer">{english?'Download the Android app':'Lataa Android-sovellus'}</a></li>
        <li><a href={links.guides}>{english?'Cleaning guides':'Siivousoppaat'}</a></li><li><a href="/sitemap.xml">{english?'Sitemap':'Sivukartta'}</a></li>
      </ul></div>
    </div>
    <div class="bottom"><small>© {new Date().getFullYear()} Hae Siivooja. {english?'Registration is free. Customers pay a €12.50 service fee when booking; cleaning work is priced separately. Cleaner subscriptions: €5.50/month or €60/year.':'Rekisteröityminen on maksutonta. Asiakkaan palvelumaksu on 12,50 € varauksen yhteydessä; siivoojan tilaus 5,50 €/kk tai 60 €/vuosi.'}</small></div>
    </div></footer>
  </body>
</html>

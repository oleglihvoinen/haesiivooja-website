---
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
import {ui} from '../data/i18n';
const {guide,lang='fi'}=Astro.props;
const en=lang==='en';
const t=ui[en?'en':'fi'];
const guideBase=en?'/en/guides/':'/oppaat/';
const canonicalPath=`${guideBase}${guide.slug}/`;
const crumbs=[{title:t.guides,href:guideBase},{title:guide.h1,href:canonicalPath}];
---
<Base title={guide.title} description={guide.description} canonicalPath={canonicalPath} breadcrumbs={crumbs} lang={lang}>
  <section class="page-intro"><div class="container"><div class="crumbs"><a href={en?'/en/':'/'}>{t.home}</a> / <a href={guideBase}>{t.guides}</a> / {guide.h1}</div><span class="eyebrow">{t.guide}</span><h1>{guide.h1}</h1><p class="lead">{guide.lead}</p></div></section>
  <section class="section"><div class="container article">{guide.sections.map(s=><section><h2>{s.h}</h2><p>{s.p}</p>{s.bullets?.length>0&&<ul class="list-clean">{s.bullets.map(b=><li>{(b.startsWith('Virallinen lähde: ')||b.startsWith('Official guidance: '))?<a href={b.replace(/^(Virallinen lähde: |Official guidance: )/,'')} rel="noopener noreferrer">{t.taxSource}</a>:b}</li>)}</ul>}</section>)}<div class="notice" style="margin:32px 0">{t.notice} {en?'The app is available in open testing on Google Play. Registration is free. Customers pay a €12.50 service fee when booking, plus the separately agreed cleaning price.':'Android-sovellus on avoimessa testauksessa Google Playssa. Rekisteröityminen on maksutonta. Asiakkaan palvelumaksu on 12,50 € varauksen yhteydessä; siivoustyöstä maksetaan erikseen.'}</div><div class="backlinks"><a class="button-secondary" href={guideBase}>{t.allGuides}</a><a class="button" href={site.playUrl} target="_blank" rel="noopener noreferrer">{en?'Get the HaeSiivooja Android app':'Avaa HaeSiivooja Google Playssa'} →</a></div></div></section>
</Base>

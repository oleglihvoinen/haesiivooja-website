---
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
import {services,guides,faqs} from '../data/marketing';
import {appScreenshots} from '../data/app-screenshots';
const {page,lang='fi'}=Astro.props;
const en=lang==='en';
const canonicalPath=en?`/en/${page.slug}/`:`/${page.slug}/`;
const breadcrumbs=[{title:page.h1,href:canonicalPath}];
const legal=['privacy','terms-of-service','accessibility-statement','app-guide','maksut','payments','cleaner','cleaner-terms','tilin-poisto','delete-account'].includes(page.slug);
const isGuides=['oppaat','guides'].includes(page.slug);
const isProfessional=['siivoojaksi','for-cleaners'].includes(page.slug);
const isPrice=['siivouksen-hinta','cleaning-prices'].includes(page.slug);
const isCustomer=['etsi-siivooja','find-a-cleaner'].includes(page.slug);
const isStory=['tietoa-meista','about-us'].includes(page.slug);
const isService=['siivouspalvelut','cleaning-services','kotisiivous','home-cleaning','muuttosiivous','move-out-cleaning','perussiivous','deep-cleaning','ikkunanpesu','window-cleaning','toimistosiivous','office-cleaning'].includes(page.slug);
const primaryFaq=page.faqs||[];
const extraFaq=(legal||isStory||isGuides)?[]:faqs[lang].filter(([q])=>!primaryFaq.some(x=>x.q===q)).map(([q,a])=>({q,a}));
const faq=[...primaryFaq,...extraFaq].slice(0,8);
const schema=faq.length>=2?[{'@type':'FAQPage',mainEntity:faq.map(f=>({'@type':'Question',name:f.q,acceptedAnswer:{'@type':'Answer',text:f.a}}))}]:[];
const serviceList=services[lang].filter(([,href])=>href!==canonicalPath);
const guideList=guides[lang];
const proUrl=en?'/en/for-cleaners/':'/siivoojaksi/';
const priceUrl=en?'/en/cleaning-prices/':'/siivouksen-hinta/';
const guidesUrl=en?'/en/guides/':'/oppaat/';
---
<Base lang={lang} title={page.title} description={page.description} canonicalPath={canonicalPath} breadcrumbs={breadcrumbs} schema={schema}>
  <section class="page-intro"><div class="container">
    <div class="crumbs"><a href={en?'/en/':'/'}>{en?'Home':'Etusivu'}</a> / {page.h1}</div>
    <span class="eyebrow">{page.eyebrow}</span><h1>{page.h1}</h1><p class="lead">{page.intro}</p>
    {!legal&&<div class="cta"><a class="button" href={site.playUrl} target="_blank" rel="noopener noreferrer">▶ {en?'Get HaeSiivooja on Google Play':'Avaa HaeSiivooja Google Playssa'}</a><a class="button-secondary" href={isProfessional?priceUrl:isService?guidesUrl:proUrl}>{isProfessional?(en?'Customer booking and pricing':'Hinnoittelu ja varaus'):isService?(en?'Cleaning guides':'Siivousoppaat'):(en?'For cleaning professionals':'Siivousalan ammattilaisille')} →</a></div>}
    {!legal&&<p class="muted">{en?'Android app in open testing. Registration is free. Customers pay a €12.50 service fee when booking; the cleaning price is separate.':'Android-sovellus on avoimessa testauksessa. Rekisteröityminen on maksutonta. Asiakas maksaa 12,50 € palvelumaksun varauksen yhteydessä; siivoustyö erikseen.'}</p>}
  </div></section>
  <section class="section"><div class="container content-layout">
    <article class="prose longform">
      {page.sections.map(section=><section class="text-section"><h2>{section.heading}</h2><p>{section.text}</p>{section.bullets?.length>0&&<ul class="list-clean">{section.bullets.map(item=><li>{item}</li>)}</ul>}</section>)}
      {isStory&&<section class="text-section">
        <h2>{en?'A sustainable digital service for Finland':'Digitaalinen ja vastuullinen ratkaisu Suomeen'}</h2>
        <p>{en?'Our goal is to build more than an app: a transparent connection between the people who need dependable cleaning help and the professionals who want meaningful work. HaeSiivooja continues to evolve through testing, feedback and improvements.':'Tavoitteemme on rakentaa enemmän kuin sovellus: läpinäkyvä yhteys siivousapua tarvitsevien ihmisten ja työtä etsivien ammattilaisten välille. HaeSiivoojaa kehitetään avoimen testauksen, käyttäjäpalautteen ja jatkuvien parannusten avulla.'}</p>
      </section>}
    </article>
    {!legal&&<aside class="content-aside"><div class="card">
      <h3>{isProfessional?(en?'For cleaning professionals':'Siivousalan ammattilaisille'):en?'Get the Android app':'Hanki Android-sovellus'}</h3>
      <p>{isProfessional?(en?'Create your profile and connect with customers in the Finnish market.':'Luo ammattilaisprofiili ja löydä asiakkaita Suomen markkinoilta.'):(en?'The actual cleaning marketplace and booking flow are in the HaeSiivooja mobile app.':'Varsinainen siivoojien ja asiakkaiden markkinapaikka sekä varaukset ovat HaeSiivooja-mobiilisovelluksessa.')}</p>
      <a href={site.playUrl} target="_blank" rel="noopener noreferrer">{en?'Open on Google Play':'Avaa Google Playssa'} →</a>
    </div>
    <p class="aside-note">{en?'AI cleaning search is an optional separate web feature.':'AI-siivoushaku on erillinen vapaaehtoinen verkkotoiminto.'} <a href={site.searchUrl}>{en?'Try AI search':'Kokeile AI-hakua'}</a></p>
    </aside>}
  </div></section>
  {['app-guide'].includes(page.slug)&&appScreenshots.length>0&&<section class="section screenshot-showcase"><div class="container">
    <h2>{en?'HaeSiivooja app screenshots':'HaeSiivooja-sovelluksen kuvakaappaukset'}</h2>
    <p class="lead">{en?'Explore the HaeSiivooja mobile experience.':'Tutustu HaeSiivooja-mobiilisovelluksen näkymiin.'}</p>
    <div class="app-gallery">{appScreenshots.slice(0,8).map((shot,index)=><figure class="app-gallery-item"><img src={shot.src} alt={en?shot.altEn:shot.altFi} loading="lazy" decoding="async" width="360" height="720"/><figcaption>{en?`App screen ${index+1}`:`Sovellusnäkymä ${index+1}`}</figcaption></figure>)}</div>
  </div></section>}
  {(isProfessional||isPrice)&&<section class="section soft"><div class="container">
    <span class="eyebrow">{en?'For professional cleaners':'Siivousalan ammattilaisille'}</span><h2>{en?'Choose how you use HaeSiivooja':'Valitse HaeSiivooja-tilaus ammattilaiselle'}</h2>
    <p class="lead">{en?'Registration for cleaners is free. Professional subscriptions cost €5.50 per month or €60 per year. Check billing and renewal conditions in the app.':'Siivoojan rekisteröityminen on maksutonta. Kuukausitilaus maksaa 5,50 € ja vuositilaus 60 €. Tarkista laskutuksen ja uusiutumisen ehdot sovelluksesta.'}</p>
    <div class="grid2">
      <article class="card price-card"><span class="eyebrow">{en?'Monthly':'Kuukausittain'}</span><h3>{en?'Monthly subscription':'Kuukausitilaus'}</h3><p>{en?'A flexible subscription period while finding customers and managing your professional presence.':'Joustava kuukausittainen tilaus, kun haluat löytää asiakkaita ja ylläpitää ammattilaisprofiiliasi.'}</p><p class="price-unverified">{en?'€5.50 / month':'5,50 € / kk'}</p><a href={site.playUrl} target="_blank" rel="noopener noreferrer">{en?'Check on Google Play':'Avaa sovellus'} →</a></article>
      <article class="card price-card"><span class="eyebrow">{en?'Annual':'Vuosittain'}</span><h3>{en?'Yearly subscription':'Vuositilaus'}</h3><p>{en?'An annual subscription for cleaners who plan to use the marketplace over the longer term.':'Vuosittainen tilaus pitkäjänteiseen asiakashankintaan ja palvelujen esittelyyn.'}</p><p class="price-unverified">{en?'€60 / year':'60 € / vuosi'}</p><a href={site.playUrl} target="_blank" rel="noopener noreferrer">{en?'Check on Google Play':'Avaa sovellus'} →</a></article>
    </div>
    <p class="market-disclaimer">{en?'Registration is free. Customers pay €12.50 when booking; cleaning work costs extra. Cleaner subscriptions are €5.50/month or €60/year.':'Rekisteröityminen on maksutonta. Asiakas maksaa 12,50 € palvelumaksun varauksen yhteydessä; siivoustyö erikseen. Siivoojan tilaus 5,50 €/kk tai 60 €/vuosi.'}</p>
  </div></section>}
  {isGuides&&<section class="section soft"><div class="container"><h2>{en?'Explore cleaning guides':'Tutustu siivousoppaisiin'}</h2><p class="lead">{en?'Practical Finnish cleaning checklists and explanations to help you prepare before hiring a professional.':'Käytännön tarkistuslistat ja siivouspalvelujen vertailuoppaat auttavat valmistautumaan ennen ammattilaisen varaamista.'}</p>
    <div class="grid3">{guideList.map(([name,href,summary])=><article class="card"><h3><a href={href}>{name}</a></h3><p>{summary}</p><a href={href}>{en?'Read the guide':'Lue opas'} →</a></article>)}</div>
  </div></section>}
  {isService&&<section class="section soft"><div class="container">
    <h2>{en?'Other cleaning services in Finland':'Muut siivouspalvelut Suomessa'}</h2><p class="lead">{en?'Explore related types of cleaning to understand what to request when you use the mobile app.':'Tutustu muihin siivoustyyppeihin, jotta voit kuvata tarpeesi selkeästi mobiilisovelluksessa.'}</p>
    <div class="grid3">{serviceList.slice(0,3).map(([name,href,symbol,summary])=><article class="card"><span class="symbol">{symbol}</span><h3><a href={href}>{name}</a></h3><p>{summary}</p><a href={href}>{en?'Read more':'Lue lisää'} →</a></article>)}</div>
    <p class="section-more"><a href={guidesUrl}>{en?'View practical cleaning guides':'Tutustu siivousoppaisiin'} →</a></p>
  </div></section>}
  {faq.length>0&&<section class="section"><div class="container prose"><span class="eyebrow">{en?'Answers':'Vastaukset'}</span><h2>{en?'Frequently asked questions':'Usein kysytyt kysymykset'}</h2><div class="faq">{faq.map(f=><details><summary>{f.q}</summary><p>{f.a}</p></details>)}</div></div></section>}
</Base>
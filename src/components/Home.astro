---
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
const {lang='fi'}=Astro.props;
const en=lang==='en';
const t=en?{
 label:'Finnish cleaning marketplace',title:'Find cleaners. Find customers.',intro:'Hae Siivooja brings together people who need cleaning and cleaning professionals looking for customers in Finland. Search near the cleaning location, compare services and book in the app.',
 customer:'I need a cleaner',customerText:'Find a cleaning professional near your home, office or cleaning job. Customer registration and booking are free.',
 cleaner:'I am a cleaner',cleanerText:'Make your skills and service area visible to people searching for cleaners. Connect with new customers.',
 primary:'Find a cleaner – free booking',secondary:'Find customers as a cleaner',
 proof1:'€0 customer booking fee',proof2:'For cleaners and customers',proof3:'Built for Finland',
 two:'One marketplace. Two ways to use it.',twoIntro:'A mobile app designed to connect cleaning needs with local professionals – not a cleaning company selling its own staff.',
 how:'How Hae Siivooja works',h1:'Customers',h2:'Cleaning professionals',
 stepsA:['Create a free customer account','Search cleaners by the location where cleaning is needed','Review the provider, services and price','Book in the app with no customer booking fee'],
 stepsB:['Create a cleaning professional profile','Describe your services and service area','Become discoverable to nearby customers','Discuss the scope and cleaning price'],
 work:'The booking is free for registered customers. The cleaning service itself is paid according to the agreement with the chosen provider.',
 categories:'Cleaning services customers search for',categoriesIntro:'Use the marketplace to find local providers for different kinds of cleaning. Availability varies by area.',
 ctaTitle:'Ready to get started?',ctaText:'Whether you need cleaning or want cleaning clients, Hae Siivooja helps both sides meet.',
 find:'Find cleaners with AI search',join:'For cleaning professionals',
 story:'Our history',storyText:'Hae Siivooja was created by Oleg Lihvoinen (Android developer) and Viktoriya Lihvoinen (UX/UI design, brand and website). The goal is to make finding cleaning work and cleaning help simpler, more transparent and more sustainable.',
 read:'Read our story',pricing:'See prices and how booking works'
}:{
 label:'Suomalainen siivousalan markkinapaikka',title:'Löydä siivooja. Löydä asiakkaita.',intro:'Hae Siivooja yhdistää siivousta tarvitsevat asiakkaat ja asiakkaita etsivät siivousalan ammattilaiset Suomessa. Hae siivoojaa työn sijainnin perusteella ja varaa sovelluksessa.',
 customer:'Tarvitsen siivoojan',customerText:'Löydä siivooja läheltä kotia, toimistoa tai muuta siivouskohdetta. Rekisteröityminen ja varaaminen ovat asiakkaalle maksuttomia.',
 cleaner:'Olen siivooja',cleanerText:'Tuo siivousosaamisesi ja palvelualueesi näkyviin. Löydä uusia asiakkaita ja siivoustöitä.',
 primary:'Etsi siivooja – varaus 0 €',secondary:'Löydä asiakkaita siivoojana',
 proof1:'0 € asiakkaan varausmaksu',proof2:'Asiakkaille ja siivoojille',proof3:'Suomen markkinoille',
 two:'Yksi markkinapaikka. Kaksi tapaa käyttää.',twoIntro:'Digitaalinen sovellus, joka yhdistää paikallisen siivoustarpeen oikeaan ammattilaiseen – ei siivousyrityksen oma henkilöstöpalvelu.',
 how:'Näin Hae Siivooja toimii',h1:'Asiakas',h2:'Siivousalan ammattilainen',
 stepsA:['Rekisteröidy asiakkaaksi maksutta','Hae siivoojaa siivouskohteen sijainnilla','Tutustu tekijään, palveluun ja hintaan','Varaa sovelluksessa ilman varausmaksua'],
 stepsB:['Luo siivousalan ammattilaisprofiili','Kerro palveluista ja toiminta-alueesta','Tee palvelusi löydettäväksi lähialueen asiakkaille','Sovi siivoustyön sisällöstä ja hinnasta'],
 work:'Varaus on rekisteröityneelle asiakkaalle maksuton. Varsinainen siivoustyö on maksullista ja hinnoitellaan valitun palveluntarjoajan kanssa.',
 categories:'Mihin siivoustarpeisiin voit löytää tekijän?',categoriesIntro:'Markkinapaikasta voi etsiä ammattilaisia erilaisiin siivoustöihin. Saatavuus vaihtelee alueittain.',
 ctaTitle:'Aloita Hae Siivoojassa',ctaText:'Tarvitsetko siivoojan vai haluatko löytää siivousasiakkaita? Hae Siivooja auttaa molempia.',
 find:'Etsi siivooja AI-haulla',join:'Siivousalan ammattilaisille',
 story:'Meidän tarinamme',storyText:'Hae Siivooja -sovelluksen loivat Android-kehittäjä Oleg Lihvoinen ja UX/UI-suunnittelija Viktoriya Lihvoinen, joka vastasi myös visuaalisesta ilmeestä ja verkkosivustosta. Tavoitteena on tehdä siivoustyön ja siivousavun löytymisestä helpompaa, läpinäkyvämpää ja kestävämpää.',
 read:'Tutustu tarinaamme',pricing:'Katso hinnat ja varaamisen ehdot'
};
const customerUrl=en?'/en/find-a-cleaner/':'/etsi-siivooja/';
const cleanerUrl=en?'/en/for-cleaners/':'/siivoojaksi/';
const priceUrl=en?'/en/cleaning-prices/':'/siivouksen-hinta/';
const storyUrl=en?'/en/about-us/':'/tietoa-meista/';
const howUrl=en?'/en/how-it-works/':'/miten-se-toimii/';
const categories=en?[
 ['Home cleaning','/en/home-cleaning/','⌂'],['Move-out cleaning','/en/move-out-cleaning/','↗'],['Deep cleaning','/en/deep-cleaning/','✧'],
 ['Window cleaning','/en/window-cleaning/','▣'],['Office cleaning','/en/office-cleaning/','▦'],['Cleaning prices','/en/cleaning-prices/','€']
]:[
 ['Kotisiivous','/kotisiivous/','⌂'],['Muuttosiivous','/muuttosiivous/','↗'],['Perussiivous','/perussiivous/','✧'],
 ['Ikkunanpesu','/ikkunanpesu/','▣'],['Toimistosiivous','/toimistosiivous/','▦'],['Siivouksen hinta','/siivouksen-hinta/','€']
];
---
<Base lang={lang} canonicalPath={en?'/en/':'/'} description={en?'Hae Siivooja is a cleaning marketplace in Finland: find and book cleaners for free after customer registration, or find customers as a cleaning professional.':'Hae Siivooja on siivoojien ja asiakkaiden suomalainen markkinapaikka. Asiakas löytää ja varaa siivoojan maksutta rekisteröitymisen jälkeen; ammattilainen löytää asiakkaita.'}>
  <section class="hero"><div class="container hero-grid">
    <div><span class="eyebrow">{t.label}</span><h1>{t.title}</h1><p class="lead">{t.intro}</p>
      <div class="cta"><a class="button" href={site.searchUrl}>{t.primary} →</a><a class="button-secondary" href={cleanerUrl}>{t.secondary} →</a></div>
      <div class="tags"><span class="tag">✓ {t.proof1}</span><span class="tag">✓ {t.proof2}</span><span class="tag">✓ {t.proof3}</span></div>
    </div>
    <div class="marketplace-visual" role="img" aria-label={en?'Illustration of a marketplace connecting cleaning customers and professionals':'Havainnekuva siivoojien ja asiakkaiden kohtaamisesta markkinapaikassa'}>
      <div class="market-top">Hae Siivooja <span>● ● ●</span></div>
      <div class="market-persona"><span class="market-avatar">⌂</span><div><strong>{t.customer}</strong><small>{en?'Cleaning help near me':'Siivousapua lähellä'}</small></div><span class="market-status">{en?'Search':'Hae'}</span></div>
      <div class="market-connection" aria-hidden="true">↓ &nbsp; ↔ &nbsp; ↑</div>
      <div class="market-persona"><span class="market-avatar professional">✦</span><div><strong>{t.cleaner}</strong><small>{en?'Customers in my area':'Asiakkaita alueeltani'}</small></div><span class="market-status">{en?'Connect':'Yhdistä'}</span></div>
      <div class="market-price">{t.proof1}</div>
    </div>
  </div></section>
  <section class="section"><div class="container">
    <span class="eyebrow">{t.how}</span><h2>{t.two}</h2><p class="lead">{t.twoIntro}</p>
    <div class="grid2">
      <article class="card persona-card"><div class="symbol">⌂</div><h3>{t.customer}</h3><p>{t.customerText}</p><ol>{t.stepsA.map(step=><li>{step}</li>)}</ol><a class="button" href={customerUrl}>{t.customer} →</a></article>
      <article class="card persona-card"><div class="symbol">✦</div><h3>{t.cleaner}</h3><p>{t.cleanerText}</p><ol>{t.stepsB.map(step=><li>{step}</li>)}</ol><a class="button-secondary" href={cleanerUrl}>{t.cleaner} →</a></article>
    </div><p class="market-disclaimer">{t.work} <a href={priceUrl}>{t.pricing} →</a></p>
  </div></section>
  <section class="section soft"><div class="container"><span class="eyebrow">{en?'Find the right professional':'Löydä tekijä tarpeeseesi'}</span><h2>{t.categories}</h2><p class="lead">{t.categoriesIntro}</p>
    <div class="grid3">{categories.map(([name,href,symbol])=><article class="card"><div class="symbol" aria-hidden="true">{symbol}</div><h3>{name}</h3><a href={href}>{en?'Explore service':'Tutustu palveluun'} →</a></article>)}</div>
  </div></section>
  <section class="section"><div class="container split"><div><span class="eyebrow">{t.story}</span><h2>{en?'Built by people who care about both sides':'Tehty siivoojia ja asiakkaita varten'}</h2><p>{t.storyText}</p><a class="button-secondary" href={storyUrl}>{t.read} →</a></div>
    <div class="card"><h3>{t.how}</h3><p>{t.twoIntro}</p><a href={howUrl}>{en?'Read the app guide':'Lue sovelluksen opas'} →</a></div>
  </div></section>
  <section class="section soft"><div class="container"><div class="cta-panel"><h2>{t.ctaTitle}</h2><p>{t.ctaText}</p><div class="cta"><a class="button-secondary" href={site.searchUrl}>{t.find} →</a><a class="button-secondary" href={cleanerUrl}>{t.join} →</a></div></div></div></section>
</Base>
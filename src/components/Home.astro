---
import Base from '../layouts/Base.astro';
import {site} from '../data/site';
import {services,guides,faqs} from '../data/marketing';
import {appScreenshots} from '../data/app-screenshots';
const {lang='fi'}=Astro.props;
const en=lang==='en';
const t=en?{
 label:'Finnish cleaning marketplace · Android open testing',
 title:'Cleaning professionals wanted in Finland. Find customers — or find a cleaner.',
 intro:'We are looking for cleaners across Finland. Join HaeSiivooja, reach people who need cleaning and find new customers. Customers can discover local cleaners and make bookings through the Android app. Registration is free for everyone.',
 download:'Get HaeSiivooja on Google Play',open:'Open testing now',
 cust:'I need a cleaner',clean:'I am a cleaner',
 custText:'Register for free and find a cleaning professional near the work location. A €12.50 customer service fee applies when making a booking; the cleaning itself is paid separately.',
 cleanText:'We are actively looking for cleaning professionals throughout Finland! Register for free, showcase your services and get discovered by customers. Monthly and yearly subscriptions are available.',
 custSteps:['Install the Android app and register for free','Search by the location of the cleaning job','Check providers, services and prices','Book in the app with a €12.50 service fee'],
 cleanSteps:['Install the Android app and register for free','Set up your professional cleaning profile','Describe services and working area','Find prospective clients and agree the job'],
 ai:'Explore AI cleaning search · optional web feature',two:'One app, two kinds of users',intro2:'A real marketplace for customers and cleaners — not a cleaning company supplying its own employees.',
 serviceTitle:'Cleaning services customers look for',serviceIntro:'Learn about different cleaning jobs, then open the app to find providers near you.',
 explore:'Learn more',guides:'Practical guides before booking',guideLink:'Read guide',
 plans:'Cleaner subscriptions',plansIntro:'Register for free as a cleaner and choose a €5.50/month or €60/year professional subscription. Subscription and renewal conditions are shown in the app.',
 monthly:'Monthly subscription',monthDesc:'Monthly billing option for cleaners looking for customers through HaeSiivooja.',
 annual:'Yearly subscription',yearDesc:'Annual billing option for professionals who plan to use HaeSiivooja throughout the year.',
 price:'Professional subscription',planLink:'Cleaner subscription details',
 noPrice:'Registration is free. Cleaner subscriptions cost €5.50 monthly or €60 yearly. Customers pay a €12.50 service fee when booking; the cleaning work costs extra.',
 story:'Our story',storyBody:'HaeSiivooja was created by Oleg Lihvoinen, mobile developer, and Viktoriya Lihvoinen, UX/UI designer responsible for the app experience, visual identity and official website.',
 storyLink:'Read our history',faq:'Frequently asked questions',free:'Free registration · €12.50 booking service fee',
 note:'Creating an account is free. Customers pay a €12.50 service fee when making a booking, plus the cleaning price agreed with the professional.',
 cta:'Try the HaeSiivooja app',ctaDesc:'The Android app is available through Google Play open testing.',allGuides:'All cleaning guides'
}:{
 label:'Suomalainen siivousalan markkinapaikka · Androidin avoin testaus',
 title:'Etsimme siivoojia ympäri Suomen! Löydä asiakkaita – tai löydä siivooja.',
 intro:'Etsimme siivousalan ammattilaisia eri puolilta Suomea HaeSiivoojaan! Luo profiili, esittele palvelusi ja löydä asiakkaita. Siivoojaa tarvitseva asiakas voi löytää paikallisen ammattilaisen Android-sovelluksella. Rekisteröityminen on kaikille maksutonta.',
 download:'Avaa HaeSiivooja Google Playssa',open:'Avoimessa testauksessa',
 cust:'Tarvitsen siivoojan',clean:'Olen siivooja',
 custText:'Rekisteröidy maksutta ja löydä siivooja siivouskohteen läheltä. Asiakkaalta veloitetaan varauksen yhteydessä 12,50 € palvelumaksu; siivoustyö maksetaan erikseen.',
 cleanText:'Etsimme siivoojia kaikkialta Suomesta! Rekisteröidy maksutta, esittele palvelualueesi ja löydä uusia asiakkaita. Valittavana on kuukausi- ja vuositilaus.',
 custSteps:['Asenna Android-sovellus ja rekisteröidy maksutta','Etsi siivoojaa siivouskohteen sijainnilla','Vertaa palveluja ja sovittavaa hintaa','Maksa varauksen yhteydessä 12,50 € palvelumaksu'],
 cleanSteps:['Asenna Android-sovellus ja rekisteröidy maksutta','Luo siivousalan ammattilaisprofiili','Kuvaile palvelusi ja toiminta-alueesi','Löydä asiakkaita ja sovi töistä'],
 ai:'Tutustu AI-siivoushakuun · erillinen verkkotoiminto',two:'Yksi sovellus, kaksi käyttäjäryhmää',intro2:'Siivoojien ja asiakkaiden markkinapaikka – ei omaa siivoushenkilökuntaa tarjoava yritys.',
 serviceTitle:'Mihin siivoustarpeisiin etsit tekijää?',serviceIntro:'Tutustu eri siivoustöihin ja etsi sitten lähellä toimivia ammattilaisia sovelluksessa.',
 explore:'Tutustu palveluun',guides:'Oppaat ennen siivouksen tilaamista',guideLink:'Lue opas',
 plans:'Siivoojan tilausvaihtoehdot',plansIntro:'Rekisteröidy siivoojaksi maksutta ja valitse 5,50 €/kk tai 60 €/vuosi. Tilauksen ehdot näet sovelluksesta.',
 monthly:'Kuukausitilaus',monthDesc:'Kuukausittainen vaihtoehto siivoojalle, joka etsii asiakkaita HaeSiivoojan kautta.',
 annual:'Vuositilaus',yearDesc:'Vuosittainen vaihtoehto ammattilaiselle, joka aikoo käyttää markkinapaikkaa pitkäjänteisesti.',
 price:'Siivoojan tilaus',planLink:'Siivoojan tilaukset ja ehdot',
 noPrice:'Rekisteröityminen on maksutonta. Siivoojalle kuukausitilaus 5,50 € tai vuositilaus 60 €. Asiakas maksaa varauksen yhteydessä 12,50 € palvelumaksun ja siivoustyöstä erikseen.',
 story:'Meidän tarinamme',storyBody:'HaeSiivoojan toteuttivat mobiilisovelluskehittäjä Oleg Lihvoinen ja UX/UI-suunnittelija Viktoriya Lihvoinen, joka suunnitteli myös sovelluksen visuaalisen ilmeen ja verkkosivuston.',
 storyLink:'Lue tarinamme',faq:'Usein kysytyt kysymykset',free:'Maksuton rekisteröityminen · palvelumaksu 12,50 €/varaus',
 note:'Rekisteröityminen on maksutonta. Asiakas maksaa varausta tehdessään 12,50 € palvelumaksun. Siivoustyöstä maksetaan lisäksi sovittu hinta siivoojalle.',
 cta:'Kokeile HaeSiivooja-sovellusta',ctaDesc:'Android-sovellus on saatavilla Google Playn avoimen testauksen kautta.',allGuides:'Kaikki siivousoppaat'
};
const custUrl=en?'/en/find-a-cleaner/':'/etsi-siivooja/';
const proUrl=en?'/en/for-cleaners/':'/siivoojaksi/';
const guidesUrl=en?'/en/guides/':'/oppaat/';
const storyUrl=en?'/en/about-us/':'/tietoa-meista/';
const priceUrl=en?'/en/cleaning-prices/':'/siivouksen-hinta/';
const appSchema={'@type':'SoftwareApplication',name:'HaeSiivooja',applicationCategory:'LifestyleApplication',operatingSystem:'Android',url:site.playUrl,description:t.intro};
---
<Base lang={lang} canonicalPath={en?'/en/':'/'} description={en?'Cleaners wanted across Finland! HaeSiivooja helps cleaning professionals find customers and people find nearby cleaners. Free registration; €12.50 customer booking service fee; €5.50/month or €60/year for cleaners.':'Etsimme siivoojia ympäri Suomen! HaeSiivooja yhdistää siivoojat ja asiakkaat. Maksuton rekisteröityminen, 12,50 € asiakasvarauksen palvelumaksu, siivoojalle 5,50 €/kk tai 60 €/vuosi.'} schema={[appSchema]}>
<section class="hero"><div class="container hero-grid">
  <div><span class="eyebrow">{t.label}</span><h1>{t.title}</h1><p class="lead">{t.intro}</p>
    <div class="cta"><a class="button" href={proUrl}>{en?'Join as a cleaner':'Liity siivoojaksi'} →</a><a class="button-secondary" href={custUrl}>{en?'Find a cleaner':'Etsi siivooja'} →</a></div><p><a class="play-inline" href={site.playUrl} target="_blank" rel="noopener noreferrer">▶ {t.download} · {t.open} →</a></p>
    <div class="tags"><span class="tag">✓ {t.free}</span><span class="tag">✓ {t.open}</span></div>
    
  </div>
  {appScreenshots.length > 0 ? (
    <figure class="real-app-hero">
      <div class="real-phone">
        <img src={appScreenshots[0].src} alt={en?appScreenshots[0].altEn:appScreenshots[0].altFi} width="420" height="840" loading="eager" decoding="async" />
      </div>
      {appScreenshots.length > 1 && <div class="real-phone secondary-phone"><img src={appScreenshots[1].src} alt={en?appScreenshots[1].altEn:appScreenshots[1].altFi} width="420" height="840" loading="eager" decoding="async" /></div>}
      <figcaption>{en?'HaeSiivooja mobile app':'HaeSiivooja-mobiilisovellus'}</figcaption>
    </figure>
  ) : (
  <div class="marketplace-visual" role="img" aria-label={en?'Illustration of customers and cleaners connecting in one app':'Havainnekuva asiakkaiden ja siivoojien kohtaamisesta'}>
    <div class="market-top">HaeSiivooja <span class="market-version">Android</span></div>
    <div class="market-persona"><span class="market-avatar">⌂</span><div><strong>{t.cust}</strong><small>{en?'Find cleaning help nearby':'Löydä siivousapua läheltä'}</small></div></div>
    <div class="market-connection">⇅</div>
    <div class="market-persona"><span class="market-avatar professional">✦</span><div><strong>{t.clean}</strong><small>{en?'Find local customers':'Löydä paikallisia asiakkaita'}</small></div></div>
    <div class="market-price">{en?'Free registration · customer booking €12.50':'Maksuton rekisteröityminen · asiakkaan palvelumaksu 12,50 €'}</div>
  </div>
  )}
</div></section>
<section class="recruit-strip"><div class="container recruit-inner"><div><span class="eyebrow">{en?'We are recruiting cleaner profiles':'Etsimme siivousalan ammattilaisia'}</span><h2>{en?'Are you a cleaner in Finland? We want you on HaeSiivooja.':'Oletko siivooja Suomessa? Tule mukaan HaeSiivoojaan!'}</h2><p>{en?'Register for free, reach customers near your service area and choose your professional subscription: €5.50/month or €60/year.':'Rekisteröidy maksutta, tavoita asiakkaita toiminta-alueellasi ja valitse 5,50 €/kk tai 60 €/vuosi maksava ammattilaisen tilaus.'}</p></div><a class="button" href={proUrl}>{en?'Join as a cleaner':'Liity siivoojaksi'} →</a></div></section>
<section class="section" id="how-it-works"><div class="container">
  <span class="eyebrow">{en?'How the marketplace works':'Näin markkinapaikka toimii'}</span><h2>{t.two}</h2><p class="lead">{t.intro2}</p>
  <div class="grid2">
    <article class="card persona-card"><div class="symbol">⌂</div><h3>{t.cust}</h3><p>{t.custText}</p><ol>{t.custSteps.map(s=><li>{s}</li>)}</ol><a class="button" href={custUrl}>{t.cust} →</a></article>
    <article class="card persona-card"><div class="symbol">✦</div><h3>{t.clean}</h3><p>{t.cleanText}</p><ol>{t.cleanSteps.map(s=><li>{s}</li>)}</ol><a class="button-secondary" href={proUrl}>{t.clean} →</a></article>
  </div><p class="market-disclaimer">{t.note} <a href={priceUrl}>{en?'Pricing explained':'Lue hinnoittelusta'} →</a></p>
</div></section>
{appScreenshots.length > 0 && <section class="section screenshot-showcase"><div class="container">
  <span class="eyebrow">{en?'Inside the app':'Sovelluksen näkymät'}</span>
  <h2>{en?'See HaeSiivooja in action':'Tutustu HaeSiivooja-sovellukseen'}</h2>
  <p class="lead">{en?'Discover the HaeSiivooja app for customers and cleaning professionals.':'Tutustu HaeSiivooja-sovelluksen näkymiin asiakkaille ja siivousalan ammattilaisille.'}</p>
  <div class="app-gallery">
    {appScreenshots.slice(0,8).map((item,index)=><figure class="app-gallery-item">
      <img src={item.src} alt={en?'HaeSiivooja mobile application interface':'HaeSiivooja-mobiilisovelluksen käyttöliittymä'} loading="lazy" decoding="async" width="360" height="720" />
      
    </figure>)}
  </div>
</div></section>}
<section class="section soft"><div class="container"><h2>{t.serviceTitle}</h2><p class="lead">{t.serviceIntro}</p>
  <div class="grid3">{services[lang].map(([name,href,symbol,desc])=><article class="card service-card"><div class="symbol">{symbol}</div><h3>{name}</h3><p>{desc}</p><a href={href}>{t.explore} →</a></article>)}</div>
</div></section>
<section class="section"><div class="container"><h2>{t.plans}</h2><p class="lead">{t.plansIntro}</p>
  <div class="grid2">
    <article class="card price-card"><span class="eyebrow">{en?'Flexible':'Joustava'}</span><h3>{t.monthly}</h3><p>{t.monthDesc}</p><p class="subscription-price">{en?'€5.50 / month':'5,50 € / kk'}</p><a class="button-secondary" href={proUrl}>{t.planLink} →</a></article>
    <article class="card price-card"><span class="eyebrow">{en?'Longer term':'Pitkäaikainen'}</span><h3>{t.annual}</h3><p>{t.yearDesc}</p><p class="subscription-price">{en?'€60 / year':'60 € / vuosi'}</p><a class="button-secondary" href={proUrl}>{t.planLink} →</a></article>
  </div><p class="market-disclaimer">{t.noPrice}</p>
</div></section>
<section class="section soft"><div class="container"><h2>{t.guides}</h2>
  <div class="grid3">{guides[lang].map(([name,href,desc])=><article class="card"><h3>{name}</h3><p>{desc}</p><a href={href}>{t.guideLink} →</a></article>)}</div>
  <p class="section-more"><a href={guidesUrl}>{t.allGuides} →</a></p>
</div></section>
<section class="section"><div class="container split">
  <div><span class="eyebrow">{t.story}</span><h2>{en?'Why we built HaeSiivooja':'Miksi HaeSiivooja syntyi?'}</h2><p>{t.storyBody}</p><a class="button-secondary" href={storyUrl}>{t.storyLink} →</a></div>
  <div><h2>{t.faq}</h2><div class="faq">{faqs[lang].map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></div>
</div></section>
<section class="section soft"><div class="container"><div class="compact-cta"><div><h2>{t.cta}</h2><p>{t.ctaDesc}</p></div><a class="button" href={site.playUrl} target="_blank" rel="noopener noreferrer">▶ {t.download}</a></div></div></section>
</Base>